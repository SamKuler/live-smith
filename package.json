{
  "name": "live-smith",
  "version": "0.3.0",
  "description": "An AI agent extension for inspecting and editing Ableton Live Sets.",
  "author": "Sam Kuler",
  "private": true,
  "type": "module",
  "main": "dist/extension.js",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts --production",
    "build:dev": "tsc --noEmit && tsx build.ts",
    "start": "npm run build:dev && extensions-cli run --storage-directory .live-smith-data",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "tsx --test \"tests/agent/**/*.test.ts\" \"tests/app/**/*.test.ts\" \"tests/attachments/**/*.test.ts\" \"tests/audio-services/**/*.test.ts\" \"tests/live/**/*.test.ts\" \"tests/model/**/*.test.ts\" \"tests/plugins/**/*.test.ts\" \"tests/release/**/*.test.ts\" \"tests/runtime/**/*.test.ts\" \"tests/skills/**/*.test.ts\" \"tests/storage/**/*.test.ts\"",
    "test:ui": "tsx --test \"tests/ui/**/*.test.ts\"",
    "verify:client": "tsx scripts/check-dialog-client-syntax.ts",
    "verify:plugins": "tsx scripts/check-plugin-fixtures.ts",
    "verify": "npm test && npm run build:dev && npm run build && npm run verify:client && npm run verify:plugins && npm audit --json",
    "package": "npm run build && extensions-cli package && npm run verify:package",
    "verify:package": "tsx scripts/verify-package.ts"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:extensions-sdk-1/ableton-extensions-sdk-1.0.0-beta.1.tgz",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "dompurify": "^3.4.13",
    "fast-xml-parser": "5.10.1",
    "fflate": "0.8.3",
    "https-proxy-agent": "9.1.0",
    "marked": "^18.0.9",
    "officeparser": "8.1.0",
    "socks-proxy-agent": "10.1.0",
    "undici": "7.29.1",
    "ws": "8.21.3",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:extensions-sdk-1/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.1.0",
    "@types/ws": "8.18.1",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
